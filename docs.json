{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "API iBarco",
  "description": "Documentação da API iBarco para parceiros integradores: busca, compra e pagamento de passagens fluviais.",
  "colors": {
    "primary": "#1565c0",
    "light": "#42a5f5",
    "dark": "#0d47a1"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navigation": {
    "groups": [
      {
        "group": "Começar",
        "pages": [
          "index",
          "primeiros-passos",
          "autenticacao",
          "conceitos"
        ]
      },
      {
        "group": "Guias",
        "pages": [
          "busca",
          "compra",
          "pagamento",
          "cancelamento",
          "reserva-de-vaga",
          "webhooks"
        ]
      },
      {
        "group": "Referência",
        "pages": [
          "referencia",
          "erros",
          "postman",
          "changelog"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Suporte",
        "href": "mailto:contato@ibarco.com.br"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Site iBarco",
      "href": "https://ibarco.com.br"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  }
}
